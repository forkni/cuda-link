# clang-tidy config for cpp_top/src/ (the C++ Custom TOP tree).
#
# Scope is enforced by the CI job (see docs/plans/CPP_TOP_IMPROVEMENT_PLAN.md, Phase 0.3),
# which only invokes clang-tidy against files under cpp_top/src/ -- never cpp_top/vendor/
# (vendored TouchDesigner SDK headers, treated as a primary source, never linted or reformatted).
#
# Requires a compile database (Phase 0.4, cpp_top/build/compile_commands.json, generated via
# the Ninja preset) so clang-tidy resolves cuda_runtime.h and the vendored TD headers.
#
# Derived from the code as written, same philosophy as .clang-format: the five check groups
# below (cppcoreguidelines-*/modernize-*/bugprone-*/performance-*/readability-*) are enabled
# wholesale so any new violation of an unlisted sub-check still fires, but a first full run
# against cpp_top/src/**/*.cpp surfaced ~2000 hits across ~50 sub-checks, almost all of them
# style preferences that conflict with this codebase's justified low-level design (raw
# pointer arithmetic parsing a byte-buffer wire protocol, byte-offset magic numbers already
# named as constants in shm_layout.h, short conventional names, C-style patterns required by
# the TD Custom TOP ABI) rather than real correctness bugs. Those sub-checks are disabled
# below with the reasoning grouped by theme; everything not listed here stayed clean on the
# first run and should keep firing on future code.

Checks: >
  -*,
  cppcoreguidelines-*,
  modernize-*,
  bugprone-*,
  performance-*,
  readability-*,
  -cppcoreguidelines-macro-usage,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-magic-numbers,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-avoid-c-arrays,
  -modernize-avoid-c-arrays,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-uppercase-literal-suffix,
  -readability-braces-around-statements,
  -readability-named-parameter,
  -readability-math-missing-parentheses,
  -readability-use-std-min-max,
  -readability-redundant-inline-specifier,
  -readability-make-member-function-const,
  -readability-convert-member-functions-to-static,
  -readability-simplify-boolean-expr,
  -readability-function-cognitive-complexity,
  -readability-enum-initial-value,
  -readability-else-after-return,
  -readability-implicit-bool-conversion,
  -cppcoreguidelines-prefer-member-initializer,
  -cppcoreguidelines-pro-type-member-init,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-virtual-class-destructor,
  -cppcoreguidelines-special-member-functions,
  -cppcoreguidelines-explicit-virtual-functions,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-init-variables,
  -cppcoreguidelines-narrowing-conversions,
  -cppcoreguidelines-avoid-const-or-ref-data-members,
  -cppcoreguidelines-c-copy-assignment-signature,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-type-static-cast-downcast,
  -modernize-use-nodiscard,
  -modernize-use-using,
  -modernize-use-equals-default,
  -modernize-use-designated-initializers,
  -modernize-use-override,
  -modernize-use-nullptr,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-branch-clone,
  -bugprone-reserved-identifier,
  -bugprone-implicit-widening-of-multiplication-result,
  -performance-enum-size

# The CUDALINK_CUDA_CHECK*/_BOOL/_FATAL macro family (src/common/cuda_check.h) is a
# sanctioned CUDA file/line error-latching idiom (matches NVIDIA's own checkCudaErrors
# pattern) -- macro-usage is disabled tree-wide rather than NOLINT'd at each of the dozen+
# call sites. It also relies on the do-while(0) idiom, hence avoid-do-while above.
#
# bugprone-empty-catch is NOT disabled here -- the tree's genuine empty `catch (...) {}`
# ABI-exception fences (F6 in docs/plans/CPP_TOP_CUDA_GUIDELINES_VERIFICATION.md) are
# deliberately silent by design (no logging/rethrow allowed to cross the plugin ABI), and
# each of those ~10 sites carries its own NOLINTNEXTLINE with that rationale rather than a
# blanket suppression, so a genuinely-forgotten empty catch elsewhere still gets flagged.
#
# Pointer-arithmetic/bounds/c-array checks are disabled tree-wide: the wire protocol
# (shm_layout.h) and both TOPs parse a raw byte buffer end-to-end (memcpy + pointer offset
# math is the implementation, not a style choice), and the TD Custom TOP ABI's own structs
# use C arrays. Magic-numbers likewise -- byte sizes/offsets are already named constants at
# their point of definition (shm_layout.h); re-litigating every call site adds no safety.
#
# Naming/brace/trailing-return-type/member-init/nodiscard/using-alias checks are disabled
# because they conflict with the project's existing, deliberate style (documented in
# .clang-format's derivation comment) rather than flag anything unsafe.

WarningsAsErrors: '*'
HeaderFilterRegex: 'cpp_top/src/.*'
FormatStyle: none

# The vendored TD SDK header (CPlusPlus_Common.h) uses offsetof() on non-standard-layout
# structs inside static_assert. The Windows SDK's <stddef.h> offsetof expands to a
# reinterpret_cast-based expression whenever _MSC_VER is defined (true for clang-tidy's
# clang-cl-compatible frontend) -- clang, unlike cl.exe, refuses to treat that as a constant
# expression, so every clang-tidy run hard-fails with clang-diagnostic-error before a single
# check can fire. Defining _CRT_USE_BUILTIN_OFFSETOF switches the SDK header onto its
# __builtin_offsetof branch instead (see stddef.h's own `#if defined _MSC_VER && !defined
# _CRT_USE_BUILTIN_OFFSETOF` guard), which both compilers accept as constant. HeaderFilterRegex
# above cannot fix this -- it only filters which diagnostics are *displayed*, not which headers
# get *compiled*, and a hard compile error anywhere in the translation unit still aborts the
# whole invocation.
ExtraArgsBefore:
  - '-D_CRT_USE_BUILTIN_OFFSETOF'
